<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WordFloat</AssemblyName>
    <Version>1.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WordFloat.Core/WordFloat.Core.csproj" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
    <EmbeddedResource Include="Assets/AppIcon.ico" LogicalName="WordFloat.Icon" />
    <EmbeddedResource Include="../../DATA-NOTICE.md" LogicalName="WordFloat.Notice.Dictionary" />
    <EmbeddedResource Include="../../Data/ECDICT-LICENSE.txt" LogicalName="WordFloat.Notice.ECDICT-License" />
    <EmbeddedResource Include="../Licenses/*.txt" LogicalName="WordFloat.Notice.%(Filename)" />
  </ItemGroup>
</Project>
